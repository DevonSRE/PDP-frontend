# Base URL for API
BASE_API_URL=http://localhost:3000

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mailjet Configuration
# Get these from https://app.mailjet.com/account
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_SECRET_KEY=your_mailjet_secret_key_here

# Email Configuration
# The email address from which emails will be sent
MAIL_FROM=support@devontech.io
# The name that will appear in the "From" field
MAIL_FROM_NAME=Pivotal Development Partners
# The email address where contact form submissions will be sent
MAIL_TO=info@pidev.org

# Security Configuration (optional)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
